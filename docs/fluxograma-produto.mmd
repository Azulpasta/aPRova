    style ANALISE fill:#fffaf0,stroke:#c49a19,stroke-width:1px
    style RISCO fill:#eef4ff,stroke:#4c79bd,stroke-width:1px
    style EVIDENCIA fill:#fff2e7,stroke:#aa641f,stroke-width:1px
