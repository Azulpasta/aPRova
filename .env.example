# Copie para .env e ajuste. O .env está no .gitignore e nunca deve ser commitado.
# Os valores abaixo são exemplos e funcionam contra o docker-compose local.

# Conexão com o PostgreSQL subido pelo docker-compose
DATABASE_URL=postgres://aprova:aprova@localhost:5432/aprova?sslmode=disable

# Conexão com o Redis subido pelo docker-compose
REDIS_URL=redis://localhost:6379/0

# Porta de escuta da API. Se ausente, o padrão é 8080
PORT=8080

# ID numérico do GitHub App, visível na página de configuração do App
GITHUB_APP_ID=000000

# Conteúdo do arquivo .pem da chave privada do GitHub App, em uma linha
GITHUB_PRIVATE_KEY=cole-aqui-o-conteudo-do-pem-do-github-app

# Segredo usado pelo GitHub para assinar os webhooks enviados a esta aplicação
GITHUB_WEBHOOK_SECRET=defina-um-valor-aleatorio-para-desenvolvimento

# Chave privada Ed25519, em base64, usada para assinar os recibos emitidos
RECEIPT_PRIVATE_KEY=gere-uma-chave-ed25519-e-cole-aqui-em-base64

# Portas que o docker-compose publica no host. Só altere se as padrão já
# estiverem ocupadas, lembrando de refletir a mudança em DATABASE_URL e REDIS_URL
POSTGRES_PORT=5432
REDIS_PORT=6379
